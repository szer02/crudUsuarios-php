<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Criar Nova Conta - DS - OUTSOURCING</title>
    
    <!-- CSS Local -->
    <link rel="stylesheet" href="{{ asset('assets/css/bootstrap.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/css/all.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/css/style.css') }}">
</head>
<body class="auth-body">

<div class="card card-auth">
    <div class="auth-header">
        <i class="fa-solid fa-user-plus text-purple mb-2" style="font-size: 2.8rem;"></i>
        <h4 class="fw-bold mt-2 mb-0 text-dark">Criar Nova Conta</h4>
        <p class="text-muted small mt-1 mb-0">Preencha os dados abaixo para se cadastrar</p>
    </div>
    
    <div class="card-body p-4 pt-3">
        {% if error %}
            <div class="alert alert-danger d-flex align-items-center" role="alert">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>
                <div>{{ error }}</div>
            </div>
        {% endif %}

        <form method="post" action="{{ path('app_register') }}">
            <div class="mb-3">
                <label for="name" class="form-label text-muted fw-semibold small">Nome Completo</label>
                <div class="input-group">
                    <span class="input-group-text border-end-0">
                        <i class="fa-solid fa-user text-muted"></i>
                    </span>
                    <input type="text" class="form-control border-start-0" id="name" name="name" required placeholder="Seu nome">
                </div>
            </div>

            <div class="mb-3">
                <label for="email" class="form-label text-muted fw-semibold small">E-mail</label>
                <div class="input-group">
                    <span class="input-group-text border-end-0">
                        <i class="fa-solid fa-envelope text-muted"></i>
                    </span>
                    <input type="email" class="form-control border-start-0" id="email" name="email" required placeholder="seu@email.com">
                </div>
            </div>

            <div class="mb-3">
                <label for="password" class="form-label text-muted fw-semibold small">Senha</label>
                <div class="input-group">
                    <span class="input-group-text border-end-0">
                        <i class="fa-solid fa-lock text-muted"></i>
                    </span>
                    <input type="password" class="form-control border-start-0" id="password" name="password" required placeholder="Mínimo de 6 caracteres">
                </div>
            </div>

            <div class="mb-4">
                <label for="confirm_password" class="form-label text-muted fw-semibold small">Confirmar Senha</label>
                <div class="input-group">
                    <span class="input-group-text border-end-0">
                        <i class="fa-solid fa-lock-open text-muted"></i>
                    </span>
                    <input type="password" class="form-control border-start-0" id="confirm_password" name="confirm_password" required placeholder="Repita a senha">
                </div>
            </div>

            <button type="submit" class="btn btn-purple w-100 py-2 fw-bold shadow-sm mb-3">
                <i class="fa-solid fa-check me-2"></i> Confirmar Cadastro
            </button>
            
            <div class="text-center mt-3">
                <span class="text-muted small">Já possui uma conta?</span>
                <a href="{{ path('app_login') }}" class="text-decoration-none small fw-semibold text-purple ms-1">Iniciar Sessão</a>
            </div>
        </form>
    </div>
</div>

<!-- JS Local -->
<script src="{{ asset('assets/js/jquery.min.js') }}"></script>
<script src="{{ asset('assets/js/bootstrap.bundle.min.js') }}"></script>
</body>
</html>