<!DOCTYPE html>
<html lang="pt-BR">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Login - DS - OUTSOURCING</title>

        <!-- CSS Local -->
        <link rel="stylesheet" href="{{ asset('assets/css/bootstrap.min.css') }}">
        <link rel="stylesheet" href="{{ asset('assets/css/all.min.css') }}">
        <link rel="stylesheet" href="{{ asset('assets/css/style.css') }}">
    </head>
    <body class="auth-body">
        
        <div class="card card-auth">
            <div class="auth-header">
                <i class="fa-solid fa-users-gear text-purple mb-2" style="font-size: 2.8rem;"></i>
                <h4 class="fw-bold mt-2 mb-0 text-dark">DS - OUTSOURCING</h4>
                <p class="text-muted small mt-1 mb-0">Introduza as suas credenciais para continuar</p>
            </div>

            <div class="card-body p-4 pt-3">
                
                <!-- Exibição de Alertas (Flash Messages) -->
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                            <i class="fa-solid fa-circle-info me-2"></i> {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    {% endfor %}
                {% endfor %}

                <!-- Formulário de Login -->
                <form action="{{ path('app_login') }}" method="POST">
                    
                    <div class="mb-3">
                        <label for="email" class="form-label text-muted fw-semibold small">E-mail</label>
                        <div class="input-group">
                            <span class="input-group-text border-end-0">
                                <i class="fa-solid fa-envelope text-muted"></i>
                            </span>
                            <input type="email" name="email" id="email" class="form-control border-start-0" required autofocus placeholder="exemplo@dominio.com">
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="password" class="form-label text-muted fw-semibold small">Palavra-passe</label>
                        <div class="input-group">
                            <span class="input-group-text border-end-0">
                                <i class="fa-solid fa-lock text-muted"></i>
                            </span>
                            <input type="password" name="password" id="password" class="form-control border-start-0" required placeholder="Digite sua senha">
                        </div>
                    </div>

                    <button type="submit" class="btn btn-purple w-100 py-2 fw-bold shadow-sm">
                        <i class="fa-solid fa-right-to-bracket me-2"></i> Entrar
                    </button>

                    <div class="text-center mt-3">
                        <span class="text-muted small">Ainda não tem conta?</span>
                        <a href="{{ path('app_register') }}" class="text-decoration-none small fw-semibold text-purple ms-1">Criar conta</a>
                    </div>
                    
                </form>

            </div>
        </div>

        <!-- JS Local -->
        <script src="{{ asset('assets/js/jquery.min.js') }}"></script>
        <script src="{{ asset('assets/js/bootstrap.bundle.min.js') }}"></script>
    </body>
</html>