{% extends 'base.html.twig' %}

{% block title %}Novo Usuário{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h2 class="h5 mb-0 text-secondary">Novo Usuário</h2>
            </div>
            <div class="card-body p-4">
                <form method="post" action="{{ path('user_new') }}">
                    <div class="mb-3">
                        <label for="name" class="form-label">Nome Completo</label>
                        <input type="text" class="form-control" id="name" name="name" required minlength="2" placeholder="Ex: Maria Silva">
                    </div>
                    <div class="mb-3">
                        <label for="email" class="form-label">E-mail</label>
                        <input type="email" class="form-control" id="email" name="email" required placeholder="nome@exemplo.com">
                    </div>
                    <div class="mb-4">
                        <label for="password" class="form-label">Senha</label>
                        <input type="password" class="form-control" id="password" name="password" required minlength="6" placeholder="Mínimo de 6 caracteres">
                    </div>
                    <div class="d-flex justify-content-between">
                        <a href="{{ path('user_index') }}" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4">Salvar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}