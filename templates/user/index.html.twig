{% extends 'base.html.twig' %}

{% block title %}Lista de Usuários{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h4 text-secondary mb-0">
        <i class="fa-solid fa-list me-2 text-purple"></i> Usuários Cadastrados
    </h2>
    <a href="{{ path('user_new') }}" class="btn btn-purple shadow-sm">
        <i class="fa-solid fa-plus me-1"></i> Novo Usuário
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Nome</th>
                        <th>E-mail</th>
                        <th>Criado em</th>
                        <th class="text-end pe-4">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr>
                            <td class="ps-4 fw-semibold">{{ user.name }}</td>
                            <td>{{ user.email }}</td>
                            <td class="text-muted small">{{ user.createdAt }}</td>
                            <td class="text-end pe-4">
                                <a href="{{ path('user_edit', {id: user.id}) }}" class="btn btn-sm btn-outline-primary me-1" title="Editar">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>
                                <form method="post" action="{{ path('user_delete', {id: user.id}) }}" class="d-inline" onsubmit="return confirm('Deseja realmente excluir este usuário?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Excluir">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-folder-open fs-1 mb-3 d-block text-light"></i>
                                Nenhum usuário encontrado. Clique em "Novo Usuário" para começar!
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}